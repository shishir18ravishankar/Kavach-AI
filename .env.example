# ---- Required (server-side only; set in Vercel → Project → Settings → Environment Variables) ----
# Private key of the app's server wallet on 0G Galileo testnet (pays storage + inference).
# Use a throwaway wallet. NEVER expose with a NEXT_PUBLIC_ prefix.
ZG_PRIVATE_KEY=

# ---- Optional (defaults shown) ----
# 0G Galileo testnet EVM RPC
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# 0G Storage indexer (turbo)
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# Pin a sealed-inference provider. Leave empty to auto-pick a decentralized
# TeeML chat provider from the on-chain list (recommended: testnet providers change).
ZG_COMPUTE_PROVIDER=
# InferenceServing contract on Galileo
ZG_INFERENCE_CONTRACT=0xa79F4c8311FF93C06b8CfB403690cc987c93F91E
# Gas price paid for 0G Storage uploads (gwei). 1000 is the lowest seen to get
# mined on Galileo (Nov 2026); the server moves up if a node demands more.
ZG_GAS_PRICE_GWEI=1000
# Never pay more than this per gas (gwei)
ZG_MAX_GAS_PRICE_GWEI=2000
# Public-demo guard: extra 0G kept in the wallet on top of one upload's real cost
ZG_MIN_RESERVE_0G=0.005
# Canonical site URL for link previews (defaults to Vercel's production URL)
NEXT_PUBLIC_SITE_URL=
# Target 0G balance for `npm run zg:fund`
FUND_TARGET=1.2
